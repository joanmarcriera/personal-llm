APP_ENV=development
PERSONAL_LLM_HOME=.
PERSONAL_LLM_CONFIG_DIR=./config
PERSONAL_LLM_DATA_DIR=./data
PERSONAL_LLM_VECTOR_BACKEND=chroma
PERSONAL_LLM_MODEL_BACKEND=auto
PERSONAL_LLM_MODEL_PROFILE=qwen2.5-7b-instruct
# For a fast end-to-end dry run, use qwen2.5-3b-instruct instead.
PERSONAL_LLM_GUARDRAIL_PROFILE=standard
PERSONAL_LLM_EMBEDDING_PROVIDER=hash
PERSONAL_LLM_CHROMA_PATH=./data/processed/chroma
PERSONAL_LLM_QDRANT_URL=http://127.0.0.1:6333
PERSONAL_LLM_OLLAMA_URL=http://127.0.0.1:11434
PERSONAL_LLM_GOOGLE_DRIVE_CLIENT_SECRET=./secrets/google-client-secret.json
PERSONAL_LLM_GOOGLE_DRIVE_TOKEN=./secrets/google-drive-token.json
PERSONAL_LLM_IMAP_HOST=
PERSONAL_LLM_IMAP_PORT=993
PERSONAL_LLM_IMAP_USERNAME=
PERSONAL_LLM_IMAP_PASSWORD=
PERSONAL_LLM_RUNPOD_API_KEY=
PERSONAL_LLM_RUNPOD_TEMPLATE_ID=
PERSONAL_LLM_REMOTE_BUCKET=
PERSONAL_LLM_LOG_LEVEL=INFO
